; Engine configuration file.

config_version=5

[application]

config/name="Tactical FPS Prototype"
run/main_scene="res://maps/killhouse.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Game="*res://core/game.gd"

[display]

